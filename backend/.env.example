PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lofilm?schema=public"
CORS_ORIGIN="http://localhost:3000"
SYNC_CRON_SCHEDULE="*/15 * * * *"

# --- Turso Cloud SQLite Configuration ---
# Khi có 2 biến này, Backend sẽ kết nối Turso Cloud thay vì file SQLite local
TURSO_DATABASE_URL="libsql://lofilm-db-yourname.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"
